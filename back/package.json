{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "docx": "^9.16.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "worker:minutes": "node dist/minutes-worker.js",
