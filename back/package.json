    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:dry-run": "stryker run --dryRunOnly",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker:meeting-integration": "node dist/meeting-integration-worker.js",
