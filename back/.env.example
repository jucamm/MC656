# Exemplo de configuração local do backend
PORT=3000

# Conexão com o banco PostgreSQL (usado para migrações e rotas de identidade)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mc656

# Origem confiável para o CORS (endereço do frontend)
TRUSTED_ORIGIN=http://localhost:5173

# Chave HMAC para proteção dos códigos de verificação (ao menos 32 caracteres)
VERIFICATION_HMAC_KEY=chave_secreta_com_pelo_menos_32_bytes_aqui

# Parâmetros de segurança para senhas
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8

# Gmail SMTP com STARTTLS. Em desenvolvimento, deixe ambas as credenciais vazias para simular.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# HU07. Captura Google e IA são independentes; notas ficam disponíveis sem credenciais.
MEET_TRANSCRIPTION_ENABLED=false
MEET_OAUTH_CLIENT_ID=
MEET_OAUTH_CLIENT_SECRET=
MEET_OAUTH_REFRESH_TOKEN=
MEET_TRANSCRIPTION_OPERATORS=
MEET_TRANSCRIPTION_POLICY_VERSION=
MEET_TRANSCRIPTION_NOTICE=

# HU10. Habilite no processo do worker após configurar o SMTP.
ACTION_ITEM_EMAIL_ENABLED=false
ACTION_ITEM_APP_URL=

# HU11. Ative apenas no processo de sincronização legislativa.
LEGISLATIVE_SYNC_ENABLED=false

# Conta Google central (offline por padrão). Nunca usar VITE_* para segredos.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_ORGANIZER_EMAIL=
GOOGLE_ORGANIZER_SUB=
GOOGLE_CALENDAR_ID=
GOOGLE_ALLOWED_INSTITUTIONAL_DOMAINS=
GOOGLE_INTEGRATION_OPERATORS=
GOOGLE_OAUTH_REDIRECT_URI=
# Caminhos privados persistentes fora da árvore servida; /tmp somente em testes.
GOOGLE_TOKEN_STORE_PATH=
# Chave de cifra independente da VERIFICATION_HMAC_KEY; formato no runbook Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=
MEETING_TRANSCRIPT_STORAGE_DIR=

# Gemini central. Ausência de chave/modelo mantém configuração pendente.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=4000
# Síntese pública só de atas aprovadas; também depende de AI_ENABLED.
LEGISLATIVE_SYNTHESIS_ENABLED=false
# Banco PostgreSQL descartável exclusivo dos testes da HU12.
HU12_TEST_DATABASE_URL=
