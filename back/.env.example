# Exemplo de configuração local do backend
PORT=3000

# Conexão com o banco PostgreSQL (usado para migrações e rotas de identidade)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mc656

# Origem confiável para o CORS (endereço do frontend)
TRUSTED_ORIGIN=http://localhost:5173

# Chave HMAC para proteção dos códigos de verificação (ao menos 32 caracteres)
VERIFICATION_HMAC_KEY=chave_secreta_com_pelo_menos_32_bytes_aqui

# Parâmetros de segurança para senhas
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8

# Envio de e-mails via Resend (opcional; sem chave, o sistema usa mocks locais)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
