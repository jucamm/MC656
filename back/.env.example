# Exemplo local: copie para back/.env. Não use credenciais de produção.
PORT=3000
# Configurações reservadas para as próximas issues; ainda não consumidas pelo servidor.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mc656
TRUSTED_ORIGIN=http://localhost:5173
# Defaults técnicos propostos; não são parâmetros atribuídos à ISO 27100.
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
# Preencha com uma chave aleatória gerada localmente. Nunca versione a chave real.
VERIFICATION_HMAC_KEY=
