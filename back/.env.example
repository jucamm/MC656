# Exemplo local: copie para back/.env. Não use credenciais de produção.
PORT=3000
# DATABASE_URL é usada por db:migrate e habilita as rotas de identidade no servidor.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mc656
# Configurações reservadas para as próximas issues.
TRUSTED_ORIGIN=http://localhost:5173
# Defaults técnicos do PasswordService; não são parâmetros atribuídos à ISO 27100.
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
# Obrigatória com DATABASE_URL: chave aleatória de ao menos 32 bytes. Nunca versione a chave real.
VERIFICATION_HMAC_KEY=
